# ─── Supabase (required) ──────────────────────────────────────────────────────
# Public — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── App URL ──────────────────────────────────────────────────────────────────
# Public client URL (used for links, redirects).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Server-only URL (used in server actions and email links).
APP_URL=http://localhost:3000

# ─── Server-only: Supabase Admin API ──────────────────────────────────────────
# SECURITY CRITICAL:
#   • NEVER prefix with NEXT_PUBLIC — this would expose it to the browser.
#   • NEVER commit .env.local with a real value.
#   • This key bypasses ALL Row Level Security policies.
#   • Used only by lib/supabase/admin.ts for in-app user management.
#   • Obtain from: Supabase Dashboard → Project Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=

# ─── Email invitations (Phase 14) ─────────────────────────────────────────────
# Required for production email invitations and password reset links.
# Until configured, credentials must be shared manually and securely.
# Obtain a key at: https://resend.com
# NEVER prefix with NEXT_PUBLIC.
RESEND_API_KEY=
EMAIL_FROM=noreply@yourdomain.com

# ─── Database (optional, for migrations via CLI) ──────────────────────────────
DATABASE_URL=

# ─── Local development only ───────────────────────────────────────────────────
# Preview auth bypass — uses a hardcoded lab_owner session without Supabase.
# Set to 1 ONLY locally when Supabase is not configured.
# NEVER set this in staging or production.
# Without this flag, missing Supabase env vars throw a configuration error.
# LABFLOW_DEV_PREVIEW=1

# ─── Feature flags ────────────────────────────────────────────────────────────
# LABFLOW_PILOT_MODE=1       — Enable pilot UX (running real cases, not full prod)
# LABFLOW_PRODUCTION_MODE=1  — Enable production mode (after all checklist items pass)

# ─── AI assistants (coming soon) ──────────────────────────────────────────────
# Claude-powered intake and QC assistant. Never commit real values.
# ANTHROPIC_API_KEY=
