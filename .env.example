# ============================================================
# LabFlow — Required Environment Variables
# Copy this file to .env.local and fill in your real values
# Never commit .env.local to git
# ============================================================

# ── Supabase ─────────────────────────────────────────────────
# Found at: Supabase Dashboard → Settings → API

# Public URL for your Supabase project
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public anon key (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Service role key — NEVER expose this to the browser
# Used only in server-side code and API routes
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ── App URLs ─────────────────────────────────────────────────
# Local dev
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Set to your production domain on Vercel
# NEXT_PUBLIC_APP_URL=https://your-domain.com

# ── Feature Flags ─────────────────────────────────────────────
# Set to 1 to show a "Preview mode" banner when Supabase is not configured
LABFLOW_DEV_PREVIEW=0

# ── AI Keys (optional — only needed for AI features) ──────────
# OpenAI key for case analysis and AI chatbot
OPENAI_API_KEY=sk-your-openai-api-key

# Anthropic Claude key for AI assistant features
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
